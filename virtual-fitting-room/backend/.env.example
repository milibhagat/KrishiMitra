# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration (for future use)
DATABASE_URL=mongodb://localhost:27017/virtual-fitting-room

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# External API Keys (Placeholder - add real keys when integrating)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_STORE_URL=your-store.myshopify.com

AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_ASSOCIATE_TAG=your_associate_tag_here

# ML/AI Service Configuration (for future ML integration)
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_ml_service_api_key_here

# JWT Secret (for future authentication)
JWT_SECRET=your_super_secure_jwt_secret_here

# Cloudinary (for image hosting - optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret