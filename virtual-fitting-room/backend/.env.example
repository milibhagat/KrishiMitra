# Virtual Fitting Room Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# External API Keys (Replace with your actual keys)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_STORE_URL=your_store.myshopify.com

AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_REGION=us-east-1

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Security Configuration
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Future ML Integration
ML_MODEL_ENDPOINT=http://localhost:8000/predict
ML_API_KEY=your_ml_api_key_here

# Database Configuration (Future Use)
DATABASE_URL=postgresql://username:password@localhost:5432/virtual_fitting_room
REDIS_URL=redis://localhost:6379

# Cloud Storage (Future Use)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Monitoring and Analytics (Future Use)
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id_here